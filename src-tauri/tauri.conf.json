{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Open Grind",
	"version": "0.1.0-beta.4",
	"identifier": "org.opengrind.app",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Open Grind",
				"width": 1000,
				"height": 800,
				"minWidth": 320,
				"minHeight": 300,
				"theme": "Dark",
				"create": false,
				"titleBarStyle": "Visible",
				"backgroundColor": "#1e1e1e",
				"generalAutofillEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'self' 'unsafe-inline'; img-src 'self' data: blob: ogmedia: http://ogmedia.localhost https://tile.openstreetmap.org https://cdns.grindr.com https://*.cloudfront.net https://*.giphy.com https://api.dicebear.com https://picsum.photos https://*.picsum.photos; media-src 'self' blob: ogmedia: http://ogmedia.localhost https://cdns.grindr.com https://*.cloudfront.net https://*.giphy.com https://test-videos.co.uk; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "nsis", "app", "dmg"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Open Grind Governance",
		"homepage": "https://opengrind.org",
		"copyright": "Copyright (c) 2026-present Open Grind Governance",
		"licenseFile": "../LICENSE",
		"category": "SocialNetworking",
		"shortDescription": "Unofficial FLOSS Grindr client",
		"longDescription": "Cross-platform, free, libre, ad-free, tracker-free, privacy-centered and community-driven Grindr client",
		"linux": {
			"deb": {
				"depends": [
					"libwebkit2gtk-4.1-0",
					"libgtk-3-0",
					"libsoup-3.0-0",
					"librsvg2-2"
				],
				"recommends": [
					"libayatana-appindicator3-1",
					"gstreamer1.0-plugins-good",
					"gstreamer1.0-plugins-bad",
					"gstreamer1.0-libav"
				]
			}
		},
		"macOS": {
			"signingIdentity": "tauri-dev"
		},
		"windows": {
			"minimumWebview2Version": "111.0.1661.34",
			"nsis": {
				"installMode": "currentUser"
			}
		},
		"android": {
			"autoIncrementVersionCode": false,
			"minSdkVersion": 28,
			"versionCode": 1040
		},
		"iOS": {
			"developmentTeam": "YOUR_TEAM_ID"
		}
	}
}
