<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Chat/tap push notifications (see org.regrind.push). Requested at launch
	     in MainActivity; API 33+ drops notifications without the grant. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<uses-permission android:name="org.opengrind.google_oauth.permission.REQUEST_TOKEN" />
	<uses-permission android:name="org.opengrind.recaptcha.permission.MINT_TOKEN" />

	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- Video calls. The webview asks for these at call time (see the generated
	     RustWebChromeClient.onPermissionRequest), which can only grant what the
	     manifest declares. Both cameras are optional so a device without one
	     still installs. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.camera.front" android:required="false" />
	<uses-feature android:name="android.hardware.microphone" android:required="false" />

	<queries>
		<package android:name="org.opengrind.google_oauth" />
		<package android:name="org.opengrind.recaptcha" />
		<package android:name="org.opengrind.fcm" />
	</queries>

	<!-- AndroidTV support -->
	<uses-feature android:name="android.software.leanback" android:required="false" />

	<application
		android:allowBackup="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:enableOnBackInvokedCallback="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:name=".ReGrindApplication"
		android:theme="@style/Theme.regrind"
		android:usesCleartextTraffic="${usesCleartextTraffic}">
		<activity
			android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
			android:launchMode="singleTask"
			android:label="@string/main_activity_title"
			android:name=".MainActivity"
			android:exported="true" />

		<!-- Launcher entries: one alias per app icon, exactly one enabled at a
		     time (see org.regrind.appicon). The discreet ones carry a neutral
		     label too. The discreet ones are written by scripts/gen-app-icons.ts. -->
		<activity-alias
			android:name=".AppIconDefault"
			android:targetActivity=".MainActivity"
			android:enabled="true"
			android:exported="true"
			android:icon="@mipmap/ic_launcher"
			android:label="@string/main_activity_title">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<!-- AndroidTV support -->
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity-alias>

