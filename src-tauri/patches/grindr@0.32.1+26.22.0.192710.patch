diff --git a/src/headers.rs b/src/headers.rs
index 9c8b2e8..7bd620b 100644
--- a/src/headers.rs
+++ b/src/headers.rs
@@ -1,3 +1,5 @@
+use std::sync::{PoisonError, RwLock};
+
 use wreq::header::{HeaderName, HeaderValue};
 
 use crate::device::DeviceInfo;
@@ -8,22 +10,43 @@ use crate::error::GrindrError;
 /// Changing it is a breaking change (it can change how requests behave), so it
 /// bumps the crate's breaking version too. The `+<apk>` suffix on the package
 /// version mirrors this string but means nothing to Cargo on its own.
-pub const APP_VERSION: &str = "26.22.0.192710";
-pub(crate) const BUILD_NUMBER: &str = "192710";
+pub const APP_VERSION: &str = "26.24.0.195444";
+pub(crate) const BUILD_NUMBER: &str = "195444";
+
+static APP_VERSION_OVERRIDE: RwLock<Option<String>> = RwLock::new(None);
+
+/// Sends `version` (e.g. `26.25.0.197000`) in place of [`APP_VERSION`] from
+/// the next request on; `None` goes back to it.
+pub fn set_app_version(version: Option<String>) {
+	*APP_VERSION_OVERRIDE
+		.write()
+		.unwrap_or_else(PoisonError::into_inner) = version;
+}
+
+/// The app version requests currently carry.
+pub fn app_version() -> String {
+	APP_VERSION_OVERRIDE
+		.read()
+		.unwrap_or_else(PoisonError::into_inner)
+		.clone()
+		.unwrap_or_else(|| APP_VERSION.to_owned())
+}
 const OKHTTP_USER_AGENT: &str = "okhttp/5.5.0";
 
 const MEDIA_ACCEPT: &str = "image/webp,image/*;q=0.8";
 
 /// Builds the `User-Agent` the app sends, e.g.
-/// `grindr3/26.22.0.192710;192710;Free;Android 14;Pixel 8;Google`.
+/// `grindr3/26.24.0.195444;195444;Free;Android 14;Pixel 8;Google`.
 ///
 /// `subscription_tier` is usually `"Free"`.
 pub fn build_user_agent(
 	device: &DeviceInfo,
 	subscription_tier: &str,
 ) -> String {
+	let version = app_version();
+	let build = version.rsplit('.').next().unwrap_or(BUILD_NUMBER);
 	format!(
-		"grindr3/{APP_VERSION};{BUILD_NUMBER};{subscription_tier};{};{};{}",
+		"grindr3/{version};{build};{subscription_tier};{};{};{}",
 		device.os, device.device_model, device.manufacturer
 	)
 }
