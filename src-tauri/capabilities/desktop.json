{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop-capability",
	"description": "Desktop-only capability (opener, broad fs, clipboard)",
	"windows": [
		"main"
	],
	"platforms": [
		"linux",
		"macOS",
		"windows"
	],
	"permissions": [
		"opener:default",
		"fs:default",
		"dialog:allow-save",
		{
			"identifier": "fs:allow-write-file",
			"allow": [
				{
					"path": "$HOME/**"
				},
				{
					"path": "$DOWNLOAD/**"
				},
				{
					"path": "$PICTURE/**"
				},
				{
					"path": "$VIDEO/**"
				},
				{
					"path": "$DESKTOP/**"
				},
				{
					"path": "$DOCUMENT/**"
				}
			]
		}
	]
}